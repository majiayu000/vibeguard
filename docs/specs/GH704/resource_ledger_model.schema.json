{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeguard.dev/specs/GH704/resource_ledger_model.schema.json",
  "title": "GH-704 ResourceLedger machine model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority", "version", "dimensions", "resource_kinds", "exact_scopes",
    "tuple_expansion_grammar", "tuples", "tuple_sets", "root_components", "roots",
    "root_capacity_scenarios", "edge_registry", "selectors", "retain_zero_contract",
    "l1_materialized_recovery"
  ],
  "properties": {
    "authority": {"const": "docs/specs/GH704/resource_ledger_model.json"},
    "version": {"type": "integer", "minimum": 1},
    "dimensions": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "prefixItems": [
        {"const": "entries"}, {"const": "bytes"}, {"const": "segments"},
        {"const": "segment_bytes"}, {"const": "per_source_quota"},
        {"const": "physical_bytes"}
      ],
      "items": false
    },
    "resource_kinds": {
      "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource_kind"}
    },
    "exact_scopes": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "tuple_expansion_grammar": {"$ref": "#/$defs/tuple_expansion_grammar"},
    "tuples": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/tuple"}},
    "tuple_sets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tuple_set"}},
    "root_components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/root_component"}},
    "roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/root"}},
    "root_capacity_scenarios": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/root_capacity_scenario"}
    },
    "edge_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "selectors": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/selector"}},
    "retain_zero_contract": {"$ref": "#/$defs/retain_zero_contract"},
    "l1_materialized_recovery": {"$ref": "#/$defs/l1_materialized_recovery"}
  },
  "$defs": {
    "resource_kind": {
      "enum": [
        "registry_live_slot", "keyed_receipt_slot", "completed_index", "outbox",
        "quarantine_frozen_lag", "success_history", "global_admin", "project_wal_live",
        "project_wal_scratch", "derived_log_live", "derived_log_scratch",
        "canonical_journal_live", "canonical_journal_scratch"
      ]
    },
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "positive_integer": {"type": "integer", "minimum": 1},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "maxima": {
      "type": "object", "additionalProperties": false,
      "required": ["entries", "bytes", "segments", "segment_bytes", "per_source_quota", "physical_bytes"],
      "properties": {
        "entries": {"$ref": "#/$defs/nonnegative_integer"},
        "bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "segments": {"$ref": "#/$defs/nonnegative_integer"},
        "segment_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "per_source_quota": {"$ref": "#/$defs/nonnegative_integer"},
        "physical_bytes": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "tuple_expansion_grammar": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "selector_reference", "finite_only", "forbidden_tokens"],
      "properties": {
        "version": {"$ref": "#/$defs/positive_integer"},
        "selector_reference": {"const": "tuple_set_id"},
        "finite_only": {"const": true},
        "forbidden_tokens": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tuple": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resource_kind", "scope_id", "quota_partition_id", "root_id", "physical_domain", "maxima"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "resource_kind": {"$ref": "#/$defs/resource_kind"},
        "scope_id": {"$ref": "#/$defs/identifier"},
        "quota_partition_id": {"$ref": "#/$defs/identifier"},
        "root_id": {"$ref": "#/$defs/identifier"},
        "physical_domain": {"$ref": "#/$defs/identifier"},
        "maxima": {"$ref": "#/$defs/maxima"}
      }
    },
    "tuple_set": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tuple_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "tuple_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "root_component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "root_id", "physical_domain", "component_type", "max_physical_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "root_id": {"$ref": "#/$defs/identifier"},
        "physical_domain": {"$ref": "#/$defs/identifier"},
        "component_type": {"enum": ["tuple", "metadata"]},
        "tuple_id": {"$ref": "#/$defs/identifier"},
        "metadata_role": {"$ref": "#/$defs/identifier"},
        "max_physical_bytes": {"$ref": "#/$defs/positive_integer"}
      },
      "allOf": [
        {"if": {"properties": {"component_type": {"const": "tuple"}}}, "then": {"required": ["tuple_id"], "not": {"required": ["metadata_role"]}}},
        {"if": {"properties": {"component_type": {"const": "metadata"}}}, "then": {"required": ["metadata_role"], "not": {"required": ["tuple_id"]}}}
      ]
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "physical_domain", "max_physical_bytes", "component_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "physical_domain": {"$ref": "#/$defs/identifier"},
        "max_physical_bytes": {"$ref": "#/$defs/positive_integer"},
        "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "capacity_axis": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "options"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "options": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    },
    "root_capacity_scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "root_id", "required_full_component_ids", "cartesian_axes", "coverage"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "root_id": {"$ref": "#/$defs/identifier"},
        "required_full_component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "cartesian_axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capacity_axis"}},
        "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["live_scratch_ab", "l1_semantic", "admin_adoption", "two_sources"]}}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "edge_type", "from_states", "to_states", "tuple_set_ids", "immutable_tuple", "receipt_requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/positive_integer"},
        "edge_type": {"enum": ["simple", "composite"]},
        "from_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "to_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "tuple_set_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "immutable_tuple": {"const": true},
        "receipt_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "expected_state": {
      "type": "object", "additionalProperties": false,
      "required": ["crash_before", "crash_after", "lost_response_after"],
      "properties": {
        "crash_before": {"$ref": "#/$defs/identifier"},
        "crash_after": {"$ref": "#/$defs/identifier"},
        "lost_response_after": {"$ref": "#/$defs/identifier"}
      }
    },
    "boundary_node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "depends_on", "pre_state", "post_state", "atomic_group", "branch", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "pre_state": {"$ref": "#/$defs/identifier"},
        "post_state": {"$ref": "#/$defs/identifier"},
        "atomic_group": {"$ref": "#/$defs/identifier"},
        "branch": {"$ref": "#/$defs/identifier"},
        "expected": {"$ref": "#/$defs/expected_state"}
      }
    },
    "boundary_path": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "nodes"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/positive_integer"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary_node"}}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "command", "edge_ids", "tuple_set_ids", "boundary_paths"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/positive_integer"},
        "command": {"type": "string", "minLength": 1},
        "edge_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "tuple_set_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "boundary_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary_path"}}
      }
    },
    "retain_zero_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_live_units_min", "empty_root_metadata_component_ids", "composite_receipt_sections"],
      "properties": {
        "payload_live_units_min": {"const": 0},
        "empty_root_metadata_component_ids": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "composite_receipt_sections": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["payload_accounting", "root_metadata_accounting"]}
        }
      }
    },
    "l1_materialized_recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["selector_id", "prepare_edge_id", "materialize_edge_id", "roll_forward_edge_id", "cleanup_edge_id", "prepared_intent_fields", "mismatch_outcomes", "exact_cleanup_requirements"],
      "properties": {
        "selector_id": {"const": "canonical_journal_l1_entitlement_capacity_one"},
        "prepare_edge_id": {"const": "l1_append_prepare"},
        "materialize_edge_id": {"const": "l1_append_materialize"},
        "roll_forward_edge_id": {"const": "l1_append_roll_forward"},
        "cleanup_edge_id": {"const": "l1_append_exact_cleanup"},
        "prepared_intent_fields": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["resource_token_id", "exact_offset", "row_digest", "max_bytes"]}
        },
        "mismatch_outcomes": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["needs_repair", "exact_truncate_or_tombstone"]}
        },
        "exact_cleanup_requirements": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"enum": ["capability_exact_offset", "tombstone_or_truncate", "file_fsync", "parent_directory_fsync", "materialized_retirement_receipt"]}
        }
      }
    }
  }
}
